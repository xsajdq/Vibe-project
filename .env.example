# ---------- Frontend (Vite) ----------
# Adres backendu (Cloudflare Worker). Lokalnie: wrangler dev → http://localhost:8787
VITE_API_URL=http://localhost:8787

# ---------- Backend (Cloudflare Worker) ----------
# Lokalnie: skopiuj poniższe do worker/.dev.vars (plik jest w .gitignore).
# Na produkcji: GitHub → Settings → Secrets and variables → Actions (AI_API_KEY jako secret).
AI_API_KEY=wklej-tutaj-klucz-gemini
# Opcjonalnie (domyślne wartości są w worker/wrangler.toml):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash
# ALLOWED_ORIGINS=http://localhost:5173
